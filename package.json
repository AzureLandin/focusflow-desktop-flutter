{
  "name": "focusflow-desktop",
  "productName": "FocusFlow",
  "version": "0.10.0",
  "license": "ISC",
  "private": true,
  "description": "本地日历待办与番茄时钟",
  "main": "dist/main.cjs",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "test": "node scripts/build.mjs test && node --test dist/domain.test.cjs",
    "test:e2e": "npm run build && node --test tests/desktop.test.mjs",
    "package:win": "npm run build && electron-builder --win nsis --x64"
  },
  "engines": {
    "node": ">=24"
  },
  "build": {
    "appId": "com.focusflow.desktop",
    "directories": {
      "output": "release/v${version}"
    },
    "files": [
      "dist/**",
      "!dist/*.test.cjs"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signExecutable": false,
      "artifactName": "FocusFlow-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2"
  }
}
